+          <StepNav
+            onBack={() => setStep(1)}
+            onNext={null}
+            onCancel={onDone}
+            onDelete={handleDelete}
+            doneLabel="Done"
+          />
+        </div>
+      )}
+    </div>
+  );
+}
+
+// ---------- Sub-components ---------------------------------------------
+
+function FormField({
+  label,
+  helper,
+  children,
+}: {
+  label: string;
+  helper?: string;
+  children: React.ReactNode;
+}) {
+  return (
+    <div>
+      <div
+        style={{
+          fontSize: 13,
+          fontWeight: 600,
+          color: "var(--gh-ink)",
+          marginBottom: helper ? 4 : 8,
+        }}
+      >
+        {label}
+      </div>
+      {helper && (
+        <div
+          style={{
+            fontSize: 12.5,
+            color: "var(--gh-muted)",
+            lineHeight: 1.5,
+            marginBottom: 10,
+            maxWidth: 600,
+          }}
+        >
+          {helper}
+        </div>
+      )}
+      {children}
+    </div>
+  );
+}
+
+function ScoreField({
+  label,
+  helper,
+  value,
+  onChange,
+}: {
+  label: string;
+  helper: string;
+  value: number | undefined;
+  onChange: (v: number | undefined) => void;
+}) {
+  return (
+    <div
+      style={{
+        display: "grid",
+        gridTemplateColumns: "200px 1fr",
+        gap: 16,
+        alignItems: "center",
+      }}
+    >
+      <div>
+        <div
+          style={{
+            fontFamily: "var(--gh-mono)",
+            fontSize: 11,
+            color: "var(--gh-ink)",
+            textTransform: "uppercase",
+            letterSpacing: "0.06em",
+            fontWeight: 600,
+          }}
+        >
+          {label}
+        </div>
+        <div
+          style={{
+            fontSize: 11.5,
+            color: "var(--gh-faint)",
+            marginTop: 2,
+            lineHeight: 1.4,
+          }}
+        >
+          {helper}
+        </div>
+      </div>
+      <AutosaveScore value={value} onSave={onChange} ariaLabel={label} />
+    </div>
+  );
+}
+
+function StepNav({
+  onBack,
+  onNext,
+  onCancel,
+  onDelete,
+  doneLabel,
+}: {
+  onBack: (() => void) | null;
+  onNext: (() => void) | null;
+  onCancel?: () => void;
+  onDelete: () => void;
+  doneLabel?: string;
+}) {
+  return (
+    <div
+      style={{
+        display: "flex",
+        justifyContent: "space-between",
+        alignItems: "center",
+        paddingTop: 16,
+        borderTop: "1px solid var(--gh-line-soft)",
+        marginTop: 8,
+      }}
+    >
+      <Btn variant="ghost" sm onClick={onDelete}>
+        Delete
+      </Btn>
+      <div style={{ display: "flex", gap: 8 }}>
+        {onBack && (
+          <Btn sm onClick={onBack}>
+            ← Back
+          </Btn>
+        )}
+        {onCancel && (
+          <Btn sm onClick={onCancel}>
+            Save & close
+          </Btn>
+        )}
+        {onNext ? (
+          <Btn sm variant="primary" onClick={onNext}>
+            Continue →
+          </Btn>
+        ) : (
+          <Btn sm variant="primary" onClick={onCancel}>
+            {doneLabel ?? "Done"}
+          </Btn>
+        )}
+      </div>
+    </div>
+  );
+}

+// ==========================================================================
+// Chip multi-select (used for tagging energy gains/drains from Profile)
+// ==========================================================================
+
+export function ChipMultiSelect({
+  options,
+  selected,
+  onChange,
+  emptyLabel = "No options yet",
+  tone = "neutral",
+}: {
+  options: string[];
+  selected: string[];
+  onChange: (next: string[]) => void;
+  emptyLabel?: string;
+  tone?: "rust" | "slate" | "neutral";
+}) {
+  if (options.length === 0) {
+    return (
+      <div
+        style={{
+          fontSize: 13,
+          color: "var(--gh-faint)",
+          fontStyle: "italic",
+        }}
+      >
+        {emptyLabel}
+      </div>
+    );
+  }
+
+  const toggle = (opt: string) => {
+    onChange(
+      selected.includes(opt)
+        ? selected.filter((s) => s !== opt)
+        : [...selected, opt]
+    );
+  };
+
+  const palette =
+    tone === "rust"
+      ? {
+          on: { bg: "var(--gh-rust)", fg: "var(--gh-canvas)", border: "var(--gh-rust)" },
+          off: { bg: "var(--gh-surface)", fg: "var(--gh-muted)", border: "var(--gh-line)" },
+        }
+      : tone === "slate"
+      ? {
+          on: { bg: "var(--gh-slate)", fg: "var(--gh-canvas)", border: "var(--gh-slate)" },
+          off: { bg: "var(--gh-surface)", fg: "var(--gh-muted)", border: "var(--gh-line)" },
+        }
+      : {
+          on: { bg: "var(--gh-ink)", fg: "var(--gh-canvas)", border: "var(--gh-ink)" },
+          off: { bg: "var(--gh-surface)", fg: "var(--gh-muted)", border: "var(--gh-line)" },
+        };
+
+  return (
+    <div style={{ display: "flex", flexWrap: "wrap", gap: 6 }}>
+      {options.map((opt) => {
+        const on = selected.includes(opt);
+        const p = on ? palette.on : palette.off;
+        return (
+          <button
+            key={opt}
+            type="button"
+            onClick={() => toggle(opt)}
+            style={{
+              padding: "6px 12px",
+              borderRadius: 999,
+              border: `1px solid ${p.border}`,
+              background: p.bg,
+              color: p.fg,
+              fontFamily: "var(--gh-sans)",
+              fontSize: 12.5,
+              fontWeight: 500,
+              cursor: "pointer",
+              maxWidth: 380,
+              textAlign: "left",
+              lineHeight: 1.35,
+              transition: "all var(--gh-dur-base) var(--gh-ease)",
+            }}
+          >
+            {opt}
+          </button>
+        );
+      })}
+    </div>
+  );
+}
+

+// ==========================================================================
+// Step indicator (used for the multi-step Conversation form)
+// ==========================================================================
+
+export function StepIndicator({
+  steps,
+  current,
+  onJump,
+}: {
+  steps: { label: string; sub?: string }[];
+  current: number;
+  onJump?: (index: number) => void;
+}) {
+  return (
+    <div
+      style={{
+        display: "grid",
+        gridTemplateColumns: `repeat(${steps.length}, 1fr)`,
+        gap: 0,
+        marginBottom: 32,
+        position: "relative",
+      }}
+    >
+      {steps.map((s, i) => {
+        const done = i < current;
+        const active = i === current;
+        const clickable = !!onJump;
+        return (
+          <button
+            key={i}
+            type="button"
+            onClick={clickable ? () => onJump!(i) : undefined}
+            disabled={!clickable}
+            style={{
+              border: "none",
+              background: "transparent",
+              padding: "12px 8px",
+              cursor: clickable ? "pointer" : "default",
+              textAlign: "left",
+              borderTop: `2px solid ${
+                active
+                  ? "var(--gh-rust)"
+                  : done
+                  ? "var(--gh-rust-line)"
+                  : "var(--gh-line)"
+              }`,
+              transition: "border-color var(--gh-dur-base) var(--gh-ease)",
+            }}
+          >
+            <div
+              style={{
+                fontFamily: "var(--gh-mono)",
+                fontSize: 10.5,
+                color: active
+                  ? "var(--gh-rust)"
+                  : done
+                  ? "var(--gh-muted)"
+                  : "var(--gh-faint)",
+                textTransform: "uppercase",
+                letterSpacing: "0.06em",
+                fontWeight: 600,
+                marginBottom: 6,
+              }}
+            >
+              {`Step ${i + 1}${done ? " ✓" : ""}`}
+            </div>
+            <div
+              style={{
+                fontSize: 14,
+                fontWeight: active ? 700 : 500,
+                color: active ? "var(--gh-ink)" : "var(--gh-muted)",
+                letterSpacing: "-0.01em",
+              }}
+            >
+              {s.label}
+            </div>
+            {s.sub && (
+              <div
+                style={{
+                  marginTop: 4,
+                  fontSize: 12,
+                  color: "var(--gh-faint)",
+                  lineHeight: 1.4,
+                }}
+              >
+                {s.sub}
+              </div>
+            )}
+          </button>
+        );
+      })}
+    </div>
+  );
+}

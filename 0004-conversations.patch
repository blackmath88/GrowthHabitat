+        padding: 4,
+        background: "var(--gh-canvas-deep)",
+        border: "1px solid var(--gh-line)",
+        borderRadius: 10,
+      }}
+    >
+      {options.map((opt) => {
+        const on = value === opt.value;
+        return (
+          <button
